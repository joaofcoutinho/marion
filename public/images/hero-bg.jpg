      <rect width="60" height="10" fill="none"/>
      <line x1="0" y1="5" x2="60" y2="5" stroke="#b8621e" stroke-width="0.5" opacity="0.4"/>
    </pattern>
  </defs>
  <rect x="880" y="480" width="160" height="120" rx="8" fill="none" stroke="#8b4a1f" stroke-width="3" opacity="0.4"/>

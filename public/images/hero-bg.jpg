<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <rect width="1920" height="1080" fill="#e8d5b5"/>
  <rect width="1920" height="1080" fill="url(#wood)" opacity="0.3"/>
